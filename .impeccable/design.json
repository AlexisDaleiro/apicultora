    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "field",
      "description": "Papel alzado, borde control de 1.5 px; hover y foco a tinta con anillo óxido.",
      "html": "<label class=\"ds-campo-etiqueta\">Localidad o zona<span>Alcanza con la localidad o el barrio.</span><input class=\"ds-campo\" type=\"text\"></label>",
      "css": ".ds-campo-etiqueta{display:block;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-weight:600;color:var(--color-ink,#202723);}.ds-campo-etiqueta span{display:block;font-weight:400;font-size:0.875rem;line-height:1.45;color:var(--color-muted,#60665B);}.ds-campo{display:block;width:100%;margin-top:0.5rem;min-height:3rem;padding:0.625rem 0.875rem;border:1.5px solid var(--color-control,#7C8273);border-radius:4px;background:var(--color-paper-raised,#FBFAF5);color:var(--color-ink,#202723);font:inherit;font-weight:400;caret-color:var(--color-oxide,#A1442F);transition:border-color 160ms cubic-bezier(0.22,1,0.36,1);}.ds-campo:hover{border-color:var(--color-ink,#202723);}.ds-campo:focus-visible{border-color:var(--color-ink,#202723);outline:2px solid var(--color-oxide,#A1442F);outline-offset:1px;}"
    },
    {
      "name": "Fichas de opción",
      "kind": "chip",
      "refersTo": "option-tile",
      "description": "Radios en fichas de 3 columnas; la elegida se llena de oliva.",
      "html": "<div class=\"ds-opciones\"><label class=\"ds-opcion\"><input type=\"radio\" name=\"ds-esp\" checked>Abejas</label><label class=\"ds-opcion\"><input type=\"radio\" name=\"ds-esp\">Avispas</label><label class=\"ds-opcion\"><input type=\"radio\" name=\"ds-esp\">No sé</label></div>",
      "css": ".ds-opciones{display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;}.ds-opcion{display:flex;align-items:center;gap:0.625rem;min-height:3rem;padding:0 0.75rem;border:1.5px solid var(--color-control,#7C8273);border-radius:4px;background:var(--color-paper-raised,#FBFAF5);color:var(--color-ink,#202723);font-weight:500;cursor:pointer;transition:border-color 160ms cubic-bezier(0.22,1,0.36,1),background-color 160ms cubic-bezier(0.22,1,0.36,1),color 160ms cubic-bezier(0.22,1,0.36,1);}.ds-opcion input{width:1.125rem;height:1.125rem;accent-color:var(--color-paper,#F2F0E8);margin:0;}.ds-opcion input:focus-visible{outline:none;}.ds-opcion:hover{border-color:var(--color-ink,#202723);}.ds-opcion:has(:checked){background:var(--color-olive,#3D4A36);border-color:var(--color-olive,#3D4A36);color:var(--color-paper,#F2F0E8);}.ds-opcion:has(:focus-visible){outline:2px solid var(--color-oxide,#A1442F);outline-offset:2px;}"
